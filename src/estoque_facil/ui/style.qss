/* Estoque Fácil — ESCOPO.md §6.
   Fonte base 14pt e alvos de clique de 40px+ são requisito, não estética. */

QWidget {
    font-size: 14pt;
    color: #1c1c1e;
    background: #f5f5f7;
}
QMainWindow, QDialog { background: #f5f5f7; }

QLabel#titulo      { font-size: 24pt; font-weight: 600; }
QLabel#subtitulo   { font-size: 15pt; color: #555; }
QLabel#secao       { font-size: 16pt; font-weight: 600; margin-top: 8px; }
QLabel#dica        { font-size: 12pt; color: #666; }

QPushButton {
    background: #ffffff;
    border: 1px solid #c9c9cf;
    border-radius: 8px;
    padding: 10px 18px;
    min-height: 40px;
}
QPushButton:hover   { background: #eef2ff; border-color: #6f86ff; }
QPushButton:pressed { background: #dfe6ff; }
QPushButton:disabled{ color: #9a9aa0; background: #ececf0; }

QPushButton#primario {
    background: #2f6df6; color: white; border: none; font-weight: 600;
    min-height: 48px; padding: 12px 26px;
}
QPushButton#primario:hover   { background: #2559d0; }
QPushButton#primario:disabled{ background: #b9c7e8; }

QPushButton#perigo { background: #ffffff; color: #b3261e; border-color: #e5a29c; }
QPushButton#perigo:hover { background: #fdecea; }

QPushButton#cartao {
    background: #ffffff; border: 1px solid #d9d9e0; border-radius: 14px;
    padding: 26px; font-size: 17pt; font-weight: 600; min-height: 120px;
    text-align: center;
}
QPushButton#cartao:hover { background: #eef2ff; border-color: #2f6df6; }

QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QTextEdit {
    background: white; border: 1px solid #c9c9cf; border-radius: 8px;
    padding: 8px 10px; min-height: 34px;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border: 2px solid #2f6df6;
}
QLineEdit#busca { font-size: 16pt; padding: 12px 14px; }

QTableView {
    background: white; border: 1px solid #d9d9e0; border-radius: 10px;
    gridline-color: #ececf0; selection-background-color: #dbe6ff;
    selection-color: #1c1c1e;
}
QTableView::item { padding: 8px; }
QHeaderView::section {
    background: #eceef4; padding: 10px; border: none;
    border-right: 1px solid #dcdce4; font-weight: 600;
}

QFrame#faixaAlerta {
    background: #fff4e5; border: 1px solid #f0c99a; border-radius: 10px; padding: 4px;
}
QFrame#faixaOk {
    background: #e8f5e9; border: 1px solid #a5d6a7; border-radius: 10px; padding: 4px;
}
QFrame#cartaoInfo {
    background: white; border: 1px solid #d9d9e0; border-radius: 10px;
}

QLabel#ok       { color: #1b5e20; font-weight: 600; }
QLabel#atencao  { color: #8a5300; font-weight: 600; }
QLabel#erro     { color: #b3261e; font-weight: 600; }

QTabWidget::pane { border: 1px solid #d9d9e0; border-radius: 10px; background: white; }
QTabBar::tab {
    padding: 10px 20px; margin-right: 4px; background: #e6e6ec;
    border-top-left-radius: 8px; border-top-right-radius: 8px; min-height: 30px;
}
QTabBar::tab:selected { background: white; font-weight: 600; }

QScrollBar:vertical { width: 14px; background: transparent; }
QScrollBar::handle:vertical { background: #c4c4cc; border-radius: 7px; min-height: 30px; }
QSTATUSBAR { font-size: 12pt; }

/* Rodapé fixo do diálogo de produto: separado do conteúdo que rola */
QFrame#rodape {
    background: #ececf0;
    border-top: 1px solid #d9d9e0;
}

/* Controles DENTRO de tabelas: o padding grande do formulário não cabe na linha */
QTableWidget QPushButton { min-height: 30px; padding: 4px 12px; }
QTableWidget QSpinBox    { min-height: 26px; padding: 4px 6px; }

/* Sem isto as setinhas do seletor numérico saem cortadas */
QSpinBox::up-button, QDoubleSpinBox::up-button,
QSpinBox::down-button, QDoubleSpinBox::down-button {
    width: 20px; background: #f0f0f4; border-left: 1px solid #d9d9e0;
}
QSpinBox::up-button, QDoubleSpinBox::up-button { subcontrol-position: top right; }
QSpinBox::down-button, QDoubleSpinBox::down-button { subcontrol-position: bottom right; }
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    image: none; border-left: 4px solid transparent; border-right: 4px solid transparent;
    border-bottom: 5px solid #55555c; width: 0; height: 0;
}
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    image: none; border-left: 4px solid transparent; border-right: 4px solid transparent;
    border-top: 5px solid #55555c; width: 0; height: 0;
}
